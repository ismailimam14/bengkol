# ==============================================================================
# BENGKOL API - DEVELOP ENVIRONMENT CONFIGURATION
# ==============================================================================
# Runtime Environment
APP_ENV=develop
APP_PORT=8080
APP_NAME=bengkol-api-dev
LOG_LEVEL=debug
UPLOAD_DIR=uploads

# Database (Local / Develop PostgreSQL 16 with PostGIS)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgrespassword
DB_NAME=bengkol_db_dev
DB_SSL_MODE=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME_MINUTES=15

# JWT Authentication Secrets (Development defaults, min 32 chars)
JWT_ACCESS_SECRET=dev-jwt-access-secret-minimum-32-chars-long!
JWT_REFRESH_SECRET=dev-jwt-refresh-secret-minimum-32-chars-long!
JWT_ACCESS_EXPIRY_MINUTES=15
JWT_REFRESH_EXPIRY_DAYS=7

# CORS Allowed Origins (* for easy local and mobile debugging)
CORS_ALLOWED_ORIGINS=*

# Optional Push Notifications (Firebase Cloud Messaging)
FCM_SERVER_KEY=
FCM_PROJECT_ID=

# Google Maps API (Android client / Geocoding)
GOOGLE_MAPS_API_KEY=
