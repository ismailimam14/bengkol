# ==============================================================================
# BENGKOL API - UAT (USER ACCEPTANCE TESTING) ENVIRONMENT CONFIGURATION
# Dedicated environment for QA validation, stakeholder testing, and pilot users
# ==============================================================================
# Runtime Environment
APP_ENV=uat
APP_PORT=8080
APP_NAME=bengkol-api-uat
LOG_LEVEL=info
UPLOAD_DIR=uploads

# Database (UAT PostgreSQL 16 with PostGIS)
DB_HOST=uat-db.bengkol.internal
DB_PORT=5432
DB_USER=bengkol_uat
DB_PASSWORD=replace-with-secure-uat-db-password
DB_NAME=bengkol_db_uat
DB_SSL_MODE=disable
DB_MAX_OPEN_CONNS=30
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME_MINUTES=15

# JWT Authentication Secrets (UAT keys, min 32 chars)
JWT_ACCESS_SECRET=uat-jwt-access-secret-minimum-32-chars-long!
JWT_REFRESH_SECRET=uat-jwt-refresh-secret-minimum-32-chars-long!
JWT_ACCESS_EXPIRY_MINUTES=15
JWT_REFRESH_EXPIRY_DAYS=7

# CORS Allowed Origins
CORS_ALLOWED_ORIGINS=https://uat.bengkol.com,https://uat-admin.bengkol.com,http://localhost:3000

# Push Notifications (Firebase Cloud Messaging - UAT project)
FCM_SERVER_KEY=
FCM_PROJECT_ID=

# Google Maps API Key
GOOGLE_MAPS_API_KEY=
