# ==============================================================================
# BENGKOL API - PRODUCTION (PROD) ENVIRONMENT CONFIGURATION
# High-availability, hardened production environment
# ==============================================================================
# Runtime Environment
APP_ENV=prod
APP_PORT=8080
APP_NAME=bengkol-api
LOG_LEVEL=warn
UPLOAD_DIR=/data/uploads

# Database (Production Highly-Available PostGIS Cluster with Required SSL)
DB_HOST=prod-db.bengkol.internal
DB_PORT=5432
DB_USER=bengkol_prod
DB_PASSWORD=replace-with-ultra-secure-production-db-password
DB_NAME=bengkol_db_prod
DB_SSL_MODE=require
DB_MAX_OPEN_CONNS=100
DB_MAX_IDLE_CONNS=25
DB_CONN_MAX_LIFETIME_MINUTES=15

# JWT Authentication Secrets (Production Cryptographically Secure Keys, min 32 chars)
JWT_ACCESS_SECRET=replace-with-strong-production-access-secret-32-chars
JWT_REFRESH_SECRET=replace-with-strong-production-refresh-secret-32-chars
JWT_ACCESS_EXPIRY_MINUTES=15
JWT_REFRESH_EXPIRY_DAYS=7

# CORS Allowed Origins (Locked down to production domains)
CORS_ALLOWED_ORIGINS=https://bengkol.com,https://admin.bengkol.com

# Push Notifications (Firebase Cloud Messaging - Production project)
FCM_SERVER_KEY=replace-with-production-fcm-server-key
FCM_PROJECT_ID=replace-with-production-fcm-project-id

# Google Maps API Key
GOOGLE_MAPS_API_KEY=replace-with-production-google-maps-api-key
