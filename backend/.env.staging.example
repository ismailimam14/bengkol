# ==============================================================================
# BENGKOL API - STAGING ENVIRONMENT CONFIGURATION
# Production mirror environment with production-grade SSL & data isolation
# ==============================================================================
# Runtime Environment
APP_ENV=staging
APP_PORT=8080
APP_NAME=bengkol-api-staging
LOG_LEVEL=info
UPLOAD_DIR=uploads

# Database (Staging Managed PostgreSQL 16 with PostGIS & SSL)
DB_HOST=staging-db.bengkol.internal
DB_PORT=5432
DB_USER=bengkol_staging
DB_PASSWORD=replace-with-secure-staging-db-password
DB_NAME=bengkol_db_staging
DB_SSL_MODE=require
DB_MAX_OPEN_CONNS=50
DB_MAX_IDLE_CONNS=15
DB_CONN_MAX_LIFETIME_MINUTES=15

# JWT Authentication Secrets (Staging keys, min 32 chars)
JWT_ACCESS_SECRET=staging-jwt-access-secret-minimum-32-chars-long!
JWT_REFRESH_SECRET=staging-jwt-refresh-secret-minimum-32-chars-long!
JWT_ACCESS_EXPIRY_MINUTES=15
JWT_REFRESH_EXPIRY_DAYS=7

# CORS Allowed Origins
CORS_ALLOWED_ORIGINS=https://staging.bengkol.com,https://staging-admin.bengkol.com

# Push Notifications (Firebase Cloud Messaging - Staging project)
FCM_SERVER_KEY=
FCM_PROJECT_ID=

# Google Maps API Key
GOOGLE_MAPS_API_KEY=
