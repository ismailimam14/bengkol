# ==============================================================================
# BENGKOL API - MASTER ENVIRONMENT TEMPLATE
# ==============================================================================
# Supported APP_ENV values: develop | uat | staging | prod
# For environment-specific templates, see:
#   - .env.develop.example (Development)
#   - .env.uat.example     (User Acceptance Testing)
#   - .env.staging.example (Staging / Pre-production)
#   - .env.prod.example    (Production)
# ==============================================================================

# Application Environment
APP_ENV=develop
APP_PORT=8080
APP_NAME=bengkol-api
LOG_LEVEL=debug
UPLOAD_DIR=uploads

# Database (PostgreSQL + PostGIS)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgrespassword
DB_NAME=bengkol_db
DB_SSL_MODE=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME_MINUTES=15

# JWT Secrets & Expiry (min 32 chars)
JWT_ACCESS_SECRET=your-super-secret-access-token-key-change-in-production-min-32-chars
JWT_REFRESH_SECRET=your-super-secret-refresh-token-key-change-in-production-min-32-chars
JWT_ACCESS_EXPIRY_MINUTES=15
JWT_REFRESH_EXPIRY_DAYS=7

# CORS Allowed Origins (Comma-separated or * for wildcard)
CORS_ALLOWED_ORIGINS=*

# Push Notifications (Firebase Cloud Messaging)
FCM_SERVER_KEY=
FCM_PROJECT_ID=

# Google Maps API (Android client / Geocoding)
GOOGLE_MAPS_API_KEY=
