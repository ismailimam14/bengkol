# Application Environment
APP_ENV=development
APP_PORT=8080
APP_NAME=bengkol-api
LOG_LEVEL=debug

# Database (PostgreSQL + PostGIS)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=bengkol_db
DB_SSL_MODE=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME_MINUTES=15

# JWT Secrets & Expiry
JWT_ACCESS_SECRET=your-super-secret-access-token-key-change-in-production-min-32-chars
JWT_REFRESH_SECRET=your-super-secret-refresh-token-key-change-in-production-min-32-chars
JWT_ACCESS_EXPIRY_MINUTES=15
JWT_REFRESH_EXPIRY_DAYS=7

# Push Notifications (Firebase Cloud Messaging - configured in later phases)
FCM_SERVER_KEY=
FCM_PROJECT_ID=

# Google Maps API (Android client / Geo-coding if needed)
GOOGLE_MAPS_API_KEY=
